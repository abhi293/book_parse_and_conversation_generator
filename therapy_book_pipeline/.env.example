
# ==========================================
# ACTIVE LLM PROVIDER
# ==========================================
# Options: openai, gemini, ollama, openrouter,
# nvidia, huggingface, groq, together,
# fireworks, deepseek, mistral, cerebras,
# xai, custom

LLM_PROVIDER=gemini
MAX_OUTPUT_TOKENS=10000  # recommended is 65000 for gemini models

# ==========================================
# OPENAI
# ==========================================

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_RPM_LIMIT=your_actual_rpm
OPENAI_TPM_LIMIT=your_actual_tpm

# ==========================================
# OPENROUTER
# ==========================================

OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# ==========================================
# GOOGLE GEMINI
# ==========================================

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_GENAI_API_VERSION=v1beta

# Gemini API configuration
GEMINI_MIN_REQUEST_INTERVAL=13
GEMINI_MAX_RETRIES=3
GEMINI_MAX_SERVER_RETRY_WAIT=300

# ==========================================
# OLLAMA
# ==========================================

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ==========================================
# NVIDIA NIM
# ==========================================

NVIDIA_API_KEY=
NVIDIA_MODEL=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_RPM_LIMIT=0
NVIDIA_TPM_LIMIT=0

# ==========================================
# HUGGING FACE
# ==========================================

HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=
HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1
HUGGINGFACE_RPM_LIMIT=0
HUGGINGFACE_TPM_LIMIT=0

# ==========================================
# GROQ
# ==========================================

GROQ_API_KEY=
GROQ_MODEL=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ==========================================
# TOGETHER AI
# ==========================================

TOGETHER_API_KEY=
TOGETHER_MODEL=
TOGETHER_BASE_URL=https://api.together.xyz/v1

# ==========================================
# FIREWORKS AI
# ==========================================

FIREWORKS_API_KEY=
FIREWORKS_MODEL=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1

# ==========================================
# DEEPSEEK
# ==========================================

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ==========================================
# MISTRAL
# ==========================================

MISTRAL_API_KEY=
MISTRAL_MODEL=
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# ==========================================
# CEREBRAS
# ==========================================

CEREBRAS_API_KEY=
CEREBRAS_MODEL=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

# ==========================================
# XAI
# ==========================================

XAI_API_KEY=
XAI_MODEL=
XAI_BASE_URL=https://api.x.ai/v1

# ==========================================
# CUSTOM OPENAI-COMPATIBLE API
# ==========================================

LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# ==========================================
# GENERAL GENERATION SETTINGS
# ==========================================

TEMPERATURE=0.1
REQUEST_TIMEOUT=600

CORPUS_RETRIES=8
QUOTA_BACKOFF_BASE=15
QUOTA_BACKOFF_MAX=300
QUOTA_DAILY_COOLDOWN_HOURS=12
MAX_INLINE_RETRY_WAIT=900

# JSON mode and sampling controls
# for OpenAI-compatible endpoints

LLM_JSON_MODE=true
LLM_SEND_TEMPERATURE=true

# Optional reasoning effort:
# low, medium, high (provider-dependent)

LLM_REASONING_EFFORT=

# ==========================================
# EXTRACTION RECOVERY
# ==========================================

RESUME_EXTRACTION=true

# ==========================================
# GENERAL CONFIGURATION
# ==========================================

MAX_CHUNKS=0
MAX_CHUNKS_PER_RUN=0

# OCR: install Tesseract separately and ensure it is on PATH.
# For Chinese, install chi_sim and/or chi_tra language data.

TESSERACT_CMD=
OCR_LANGUAGES=eng+chi_sim+chi_tra

# ==========================================
# PIPELINE
# ==========================================

INPUT_DIR=./books
OUTPUT_DIR=./output
CHUNK_CHARS=6000
CHUNK_OVERLAP=500

OCR_MODE=auto
OCR_MIN_TEXT_CHARS=80

# Terminal status is printed every N pages.
# Set to 10 if per-page output is too noisy.

PROGRESS_EVERY_PAGES=1

# OCR_RENDER_SCALE=2 is accurate but slow.
# Use 1.5 for a faster first pass.

OCR_RENDER_SCALE=2

# Skip only a page whose individual OCR call
# exceeds this limit; ingestion continues.

OCR_PAGE_TIMEOUT=300
