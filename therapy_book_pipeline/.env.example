# Choose: openai or ollama
# ==========================================
# ACTIVE LLM PROVIDER
# ==========================================

LLM_PROVIDER=gemini

# ==========================================
# OPENAI
# ==========================================

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# ==========================================
# OPENROUTER
# ==========================================

OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# ==========================================
# GOOGLE GEMINI
# ==========================================

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ==========================================
# OLLAMA
# ==========================================

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ==========================================
# GENERAL CONFIGURATION
# ==========================================

TEMPERATURE=0.1
MAX_OUTPUT_TOKENS=8192
REQUEST_TIMEOUT=600

MAX_CHUNKS=0


# OCR: install Tesseract separately and ensure it is on PATH.
# For Chinese, install chi_sim and/or chi_tra language data.
TESSERACT_CMD=
OCR_LANGUAGES=eng+chi_sim+chi_tra

# Pipeline
INPUT_DIR=./books
OUTPUT_DIR=./output
CHUNK_CHARS=6000
CHUNK_OVERLAP=500
OCR_MODE=auto
OCR_MIN_TEXT_CHARS=80
MAX_CHUNKS_PER_RUN=0
