# Choose: openai or ollama
# ==========================================
# ACTIVE LLM PROVIDER
# ==========================================

LLM_PROVIDER=gemini

# ==========================================
# OPENAI
# ==========================================

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_RPM_LIMIT=your_actual_rpm
OPENAI_TPM_LIMIT=your_actual_tpm

MAX_OUTPUT_TOKENS=8192
CORPUS_RETRIES=5
QUOTA_BACKOFF_BASE=30
QUOTA_BACKOFF_MAX=300

QUOTA_DAILY_COOLDOWN_HOURS=12
MAX_INLINE_RETRY_WAIT=900

# ==========================================
# OPENROUTER
# ==========================================

OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# ==========================================
# GOOGLE GEMINI
# ==========================================

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CORPUS_RETRIES=5
QUOTA_BACKOFF_BASE=15
QUOTA_BACKOFF_MAX=300
GOOGLE_GENAI_API_VERSION=v1beta

# Gemini API configuration
GEMINI_MIN_REQUEST_INTERVAL=13
GEMINI_MAX_RETRIES=3
GEMINI_MAX_SERVER_RETRY_WAIT=300

# Extraction recovery
RESUME_EXTRACTION=true
# ==========================================
# OLLAMA
# ==========================================

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ==========================================
# GENERAL CONFIGURATION
# ==========================================

TEMPERATURE=0.1
MAX_OUTPUT_TOKENS=8192
REQUEST_TIMEOUT=600

MAX_CHUNKS=0


# OCR: install Tesseract separately and ensure it is on PATH.
# For Chinese, install chi_sim and/or chi_tra language data.
TESSERACT_CMD=
OCR_LANGUAGES=eng+chi_sim+chi_tra

# Pipeline
INPUT_DIR=./books
OUTPUT_DIR=./output
CHUNK_CHARS=6000
CHUNK_OVERLAP=500
OCR_MODE=auto
OCR_MIN_TEXT_CHARS=80
# Terminal status is printed every N pages. Set to 10 if per-page output is too noisy.
PROGRESS_EVERY_PAGES=1
# OCR_RENDER_SCALE=2 is accurate but slow. Use 1.5 for a faster first pass.
OCR_RENDER_SCALE=2
# Skip only a page whose individual OCR call exceeds this limit; ingestion continues.
OCR_PAGE_TIMEOUT=300
MAX_CHUNKS_PER_RUN=0
